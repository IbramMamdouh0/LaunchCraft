{
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "env": {
    "VERCEL_PHP_VERSION": "8.2"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
